{
  "name": "@ctrl/react-adsense",
  "version": "0.0.0-placeholder",
  "description": "React component for Google AdSense",
  "keywords": [
    "ads",
    "adsense",
    "google",
    "react",
    "typescript"
  ],
  "homepage": "https://react-adsense.xmplaylist.com",
  "license": "MIT",
  "author": "Scott Cooper <scttcper@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scttcper/react-adsense.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "demo:build": "pnpm --filter demo-app build",
    "demo:watch": "pnpm --filter demo-app dev",
    "lint": "oxfmt --check && oxlint .",
    "lint:fix": "oxfmt && oxlint . --fix",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@ctrl/oxlint-config": "1.5.0",
    "@sindresorhus/tsconfig": "8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "packageManager": "pnpm@12.15.0"
}
